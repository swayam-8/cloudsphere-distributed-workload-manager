{
  "name": "cloudsphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/start-local.mjs",
    "start": "node backend/server.mjs",
    "worker": "node worker/agent.mjs",
    "build:jobs": "node scripts/build-job-image.mjs",
    "build": "npm run build --prefix frontend",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:ui": "npm test --prefix frontend",
    "smoke": "node scripts/smoke.mjs",
    "aws:inspect": "node scripts/aws-inspect.mjs",
    "dev:aws": "node scripts/start-local.mjs --aws",
    "build:batch": "node scripts/build-batch-image.mjs",
    "aws:deploy": "node scripts/aws-deploy.mjs",
    "test:batch-image": "node --test tests/aws-runtime/*.test.mjs",
    "aws:smoke": "node scripts/aws-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-batch": "^3.1169.0",
    "@aws-sdk/client-cloudwatch": "^3.900.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-ec2": "^3.900.0",
    "@aws-sdk/client-ecr": "^3.1169.0",
    "@aws-sdk/client-ecs": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-sts": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "mongodb": "^6.20.0",
    "zod": "^4.1.0"
  }
}
