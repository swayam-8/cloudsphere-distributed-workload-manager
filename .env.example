# Copy to .env for manual operation. Never commit the populated file.
CLOUDSPHERE_MODE=LOCAL
CLOUDSPHERE_OPERATOR_TOKEN=
CLOUDSPHERE_ENROLLMENT_TOKEN=
CLOUDSPHERE_MONGODB_URI=mongodb://127.0.0.1:27017/cloudsphere?replicaSet=rs0
CLOUDSPHERE_DATA_DIR=.local/data
CLOUDSPHERE_API_URL=http://127.0.0.1:8000
# AWS mode requires a secured MongoDB replica set/Atlas, IAM roles, S3 and HTTPS.
CLOUDSPHERE_AWS_REGION=ap-south-1
CLOUDSPHERE_S3_BUCKET=
